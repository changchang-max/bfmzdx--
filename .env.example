# 智能查寝打卡 · 环境变量模板
# 用法：复制本文件为 .env 后填写真实值。.env 已被 .gitignore 忽略，不要提交、不要截图外发。

# ─── 账号（必填）─────────────────────────────────────
NMU_USER=20230001
NMU_PASS=your-password

# ─── 服务端口 ────────────────────────────────────────
PORT=8787

# ─── 调试脚本用：智能查寝微应用入口 URL（含 code / ticket，属于一次性令牌，只在本地保存）──
# 从手机端「智能查寝」入口复制完整地址后粘贴到下面
# NMU_APP_URL=https://xsfw.nmu.edu.cn/xsfw/sys/swmzncqapp/*default/index.do?code=<CODE>&state=&ticket=<TICKET>#/xscq/kqqdx

# ─── 默认打卡坐标（百度 BD09，东2学生社区中心示例，非敏感信息）──
CHECKIN_LNG=106.109536
CHECKIN_LAT=38.500879

# ─── UI 测试脚本访问的本地地址 ──────────────────────
BASE=http://127.0.0.1:8787